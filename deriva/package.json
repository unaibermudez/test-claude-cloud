{
  "name": "deriva",
  "version": "1.1.0",
  "private": true,
  "description": "DERIVA — roguelike de ciencia ficción y terror psicológico a bordo de la Estación Perséfone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint .",
    "bot": "tsx scripts/bot.ts",
    "content": "tsx scripts/content-check.ts",
    "e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run content && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
